# Database (Neon PostgreSQL)
# Pooled connection string for serverless functions
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/qbitx?sslmode=require"
# Direct / Unpooled connection string for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/qbitx?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional - Leave blank to disable Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Service (Resend - Optional in local dev, logs to console if empty)
RESEND_API_KEY=""
EMAIL_FROM="QbitX <no-reply@qbitx.com>"

# AI Integration (Google Gemini - Optional in local dev, shows honest disabled notice if empty)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Initial Super Admin Bootstrap (Run: npm run db:seed or CLI bootstrap script)
INITIAL_ADMIN_EMAIL="admin@qbitx.com"
INITIAL_ADMIN_PASSWORD="ChangeMeInProduction123!"
INITIAL_ADMIN_NAME="System Administrator"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
